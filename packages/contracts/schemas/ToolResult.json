{
  "$defs": {
    "DataGap": {
      "additionalProperties": false,
      "properties": {
        "period_end": {
          "format": "date-time",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/DataGapReason"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "period_start",
        "period_end",
        "reason"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "DataGapReason": {
      "enum": [
        "no_data",
        "not_parsed",
        "not_visible",
        "query_failed",
        "budget_exhausted"
      ],
      "title": "DataGapReason",
      "type": "string"
    },
    "JsonValue": {},
    "ToolCoverage": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/DataGap"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "complete",
        "gaps"
      ],
      "title": "ToolCoverage",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "ok",
        "denied",
        "error"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/ToolCoverage"
    },
    "data": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Data",
      "type": "array"
    },
    "deny_reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deny Reason"
    },
    "evidence_id": {
      "anyOf": [
        {
          "pattern": "^ev_\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Id"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "data",
    "truncated",
    "coverage"
  ],
  "title": "ToolResult",
  "type": "object"
}
