# Prod shadow stack'in ayarları (docker-compose.prod.yaml). Bu dosyayı .env.prod olarak kopyala
# (git yok sayar) ve her değeri doldur. .env.prod'u asla commit etme.
#
# Sır olanlar için rastgele hex kullan (`openssl rand -hex 24`): Compose ve Temporal'ın yapılandırma
# şablonu $, " ve \ karakterlerini özel yorumlar.

# Release sürümü: ais0c-platform, ais0c-ui ve ais0c-mcp-gateway imajlarının etiketi (docker load ile yüklenir).
AIS0C_VERSION=
# make_secrets.py --directory ile üretilen sır dizininin mutlak yolu (agents/, executor/, mcp/, qradar/, api/, ui/).
AIS0C_SECRETS_DIR=

# PostgreSQL "postgres" süper kullanıcısı; yalnızca ilk kurulum ve yönetim için.
POSTGRES_PASSWORD=
# Uygulama rolü "ais0c"; ais0c veritabanının sahibi.
AIS0C_DB_PASSWORD=
# Temporal'ın "temporal" rolü; temporal ve temporal_visibility veritabanlarının sahibi.
TEMPORAL_DB_PASSWORD=
# Servislerin LiteLLM'e bearer token olarak gönderdiği anahtar.
LITELLM_MASTER_KEY=

# DeepSeek V4 Flash vLLM sunucusunun adresi, /v1 yolu dahil (bütün model alias'ları).
VLLM_DEEPSEEK_V4_FLASH_API_BASE=
# Aynı sunucunun API anahtarı; yalnızca vLLM --api-key ile çalışıyorsa gerekir.
VLLM_DEEPSEEK_V4_FLASH_API_KEY=

# QRadar konsolunun adı veya IP'si (isteğe bağlı port ile); qradar-mcp instance'ları buna bağlanır.
QRADAR_CONSOLE_FQDN=
# QRadar sertifika denetimi. Boş değer true demektir; false yalnızca kendinden imzalı sertifika için.
QRADAR_VERIFY_SSL=

# E-posta relay'inin adı veya adresi (executor worker).
AIS0C_SMTP_HOST=
# Relay portu. Boşsa TLS kipine göre 587, 465 veya 25.
AIS0C_SMTP_PORT=
# Relay TLS kipi: starttls, implicit veya none. Boşsa starttls.
AIS0C_SMTP_TLS=
# Uyarı e-postalarının gönderen adresi.
AIS0C_SMTP_FROM=
# Relay girişi için kullanıcı adı; parolası ${AIS0C_SECRETS_DIR}/executor/smtp-password dosyasındadır. Giriş yoksa boş bırak.
AIS0C_SMTP_USERNAME=

# Platformun vaka sayfasının https tabanı, sonunda "/" olmadan; nottaki ve e-postadaki vaka linki buradan kurulur.
AIS0C_CASE_URL_BASE=
# QRadar konsolunda offense sayfasının https adresi; {offense_id} yer tutucusunu bir kez içerir. Boşsa link verilmez.
AIS0C_QRADAR_OFFENSE_URL_TEMPLATE=

# API kimlik doğrulama kipi; bugün yalnızca dev (OIDC T-035'te gelir).
AIS0C_API_AUTH=
# UI'nin 8443 portunu bağlayacağı sunucu adresi. Boşsa 0.0.0.0 (tüm arayüzler).
AIS0C_UI_BIND=

# Sağlık alarmlarının gönderileceği syslog sunucusu (H-8). Boşsa alarmlar yalnızca e-postayla gider.
AIS0C_ALARM_SYSLOG_HOST=
# Syslog portu. Boşsa 514.
AIS0C_ALARM_SYSLOG_PORT=
# Syslog protokolü: udp veya tcp. Boşsa udp.
AIS0C_ALARM_SYSLOG_PROTOCOL=
