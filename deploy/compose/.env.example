# Secrets of the dev stack (docker-compose.dev.yaml). Copy this file to deploy/compose/.env,
# which git ignores, and fill in every value. Never commit .env.
#
# Use random hex strings, for example `openssl rand -hex 24`: Compose and Temporal's config
# template treat some special characters ($, ", \) specially.

# PostgreSQL superuser "postgres": used by the init script and for administration only.
POSTGRES_PASSWORD=
# Application role "ais0c", owner of the ais0c database.
AIS0C_DB_PASSWORD=
# Role "temporal", owner of the temporal and temporal_visibility databases.
TEMPORAL_DB_PASSWORD=
# Key that clients (agents, the smoke script) send to LiteLLM as a bearer token.
LITELLM_MASTER_KEY=
# OpenRouter API key, dev only (D-10). Optional: without it the stack starts, model calls fail
# and the LiteLLM smoke script is skipped.
OPENROUTER_API_KEY=
